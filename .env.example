# ============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored — NEVER commit
# real keys, never log them, never return them in an API response.
#
# All secrets are read exclusively via os.environ[...] at startup. The app
# fails fast with a clear error if an expected variable is missing.
# ============================================================================

# PostgreSQL (raw `emails` table + derived tables live in this database)
PLACEMENT_PG_PASSWORD=

# ---- LLM provider router (priority: Gemini -> Groq -> DeepSeek) ------------
# One variable per account. Accounts round-robin inside a provider; failures
# fail over to the next account, then the next provider.
# Log labels only: gemini_1..3, groq_1..3, deepseek_1..4 (never the key).
#
# PLACEMENT_HYBRID_LLM=true is the default: the LLM is authoritative for
# final-selection candidate emails. Set it to false only for offline runs -
# when it is true, startup FAILS FAST if any variable below is missing.
PLACEMENT_HYBRID_LLM=true

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

DEEPSEEK_API_KEY_1=
DEEPSEEK_API_KEY_2=
DEEPSEEK_API_KEY_3=
DEEPSEEK_API_KEY_4=
