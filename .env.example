# ============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored — NEVER commit
# real keys, never log them, never return them in an API response.
#
# All secrets are read exclusively via os.environ[...] at startup. The app
# fails fast with a clear error if an expected variable is missing.
# ============================================================================

# PostgreSQL (raw `emails` table + derived tables live in this database)
PLACEMENT_PG_PASSWORD=

# ---- Mail transport: IMAP + Gmail app password (Gmail REST API retired) -----
# Mail is fetched with stdlib imaplib over TLS. NO OAuth, NO credentials.json,
# NO token.json - the app password below is the only credential.
#
# How to make one: Google Account -> Security -> 2-Step Verification ON
#                  -> App passwords -> create "JIIT placement backend"
# It is 16 characters, shown in groups of 4; enter it WITHOUT the spaces.
# 2-Step Verification must be ON or Google will not issue an app password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=
IMAP_APP_PASSWORD=
IMAP_MAILBOX=INBOX

# Watcher behaviour (see app/gmail/imap_watcher.py + scripts/watch_mail.py)
# IMAP_POLL_SECONDS=60            # seconds between cycles
# IMAP_MARK_SEEN_AFTER_STORE=true # mark \Seen only after the row committed
# IMAP_IDLE_ENABLED=false         # use IMAP IDLE when offered (else polling)
# IMAP_MAX_RETRIES=5              # PENDING after N retries -> FAILED (poison)
# IMAP_BACKOFF_BASE=2             # reconnect backoff, seconds
# IMAP_BACKOFF_CAP=300
#
# Pacing / sizing keep their existing names:
# GMAIL_MIN_INTERVAL_MS=1100      # spacing between IMAP command groups
# GMAIL_PAGE_SIZE=100             # ids per listing page
# GMAIL_MAX_ATTACHMENT_BYTES=5242880
# GMAIL_REQUEST_TIMEOUT=30
# GMAIL_SOURCE_GROUPS=jiitengg2027@googlegroups.com,jaypeeengg2027@googlegroups.com

# ---- LLM provider router (priority: Gemini -> Groq -> DeepSeek) ------------
# One variable per account. Accounts round-robin inside a provider; failures
# fail over to the next account, then the next provider.
# Log labels only: gemini_1..3, groq_1..3, deepseek_1..4 (never the key).
#
# PLACEMENT_HYBRID_LLM=true is the default: the LLM is authoritative for
# final-selection candidate emails. Set it to false only for offline runs -
# when it is true, startup FAILS FAST if any variable below is missing.
PLACEMENT_HYBRID_LLM=true

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

DEEPSEEK_API_KEY_1=
DEEPSEEK_API_KEY_2=
DEEPSEEK_API_KEY_3=
DEEPSEEK_API_KEY_4=
