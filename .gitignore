# Secrets (never commit: PG password, Gmail IMAP app password)
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Local data (regenerated by ingestion; never commit mailbox content)
data/
*.sqlite3
*.db
*.jsonl
!reports/*.md
# per-email extraction report carries student names + roll numbers
reports/*.csv

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime output (regenerated on every run)
logs/

# Mail auto-watcher runtime (single-instance lock, status, stop flag)
.imap_watcher.lock
.imap_watcher_status.json
.imap_watcher_status.json.tmp
.imap_watcher.stop

# Retired Gmail OAuth material (the backend uses an IMAP app password now)
.gmail_token.json
gmail_token.json
